{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "dev.socialtap/mcp",
  "title": "SocialTap",
  "description": "Social media scraper API. Live data from any public link.",
  "version": "1.1799.0",
  "websiteUrl": "https://socialtap.dev/mcp/",
  "repository": {
    "url": "https://github.com/SocialTapDev/socialtap-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://socialtap.dev/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": [
        "any"
      ]
    },
    {
      "src": "https://socialtap.dev/apple-touch-icon.png",
      "mimeType": "image/png",
      "sizes": [
        "180x180"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://socialtap.dev/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Bearer <your SocialTap API key>: needed for every tool but find_endpoint, search_docs and read_doc",
          "isRequired": false,
          "isSecret": true
        }
      ]
    }
  ]
}
